---
import { withBase } from '../config/site.mjs';
const promises = [
  { number: '01', title: 'Make “done” provable', text: 'Carry one change through merge and the focused post-merge check that proves it arrived.', href: '/what-it-does/ship-a-change/', icon: 'switch' },
  { number: '02', title: 'Let the fleet converge', text: 'Read exact drift across a five-machine macOS/Linux mix, then move each host toward declared state.', href: '/what-it-does/keep-machines-current/', icon: 'signal' },
  { number: '03', title: 'Promote through evidence', text: 'Declare a skill once, review the item, prove the canary, and let signed history carry it outward.', href: '/what-it-does/distribute-a-skill/', icon: 'box' },
  { number: '04', title: 'Place work with intent', text: 'Route a request to the harness, model, effort, and ready machine that fit it.', href: '/what-it-does/run-work-on-another-machine/', icon: 'route' },
];
---
<section class="promises wrap" aria-labelledby="promises-title">
  <div class="section-heading"><p class="eyebrow">The operating practice</p><h2 id="promises-title">Four habits.<br /><span>One accountable system.</span></h2></div>
  <div class="promise-grid">
    {promises.map((promise) => <a class="promise-card" href={withBase(promise.href)}>
      <span class="card-number">{promise.number}</span><span class={`promise-icon icon-${promise.icon}`} aria-hidden="true"></span>
      <h3>{promise.title}</h3><p>{promise.text}</p><span class="card-arrow" aria-hidden="true">↗</span>
    </a>)}
  </div>
</section>
