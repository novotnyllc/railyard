---
import { withBase } from '../config/site.mjs';
const promises = [
  { number: '01', title: 'Ship a change', text: 'Say what should change and receive a merged result with a focused post-merge receipt.', href: '/what-it-does/ship-a-change/', icon: 'switch' },
  { number: '02', title: 'Keep machines current', text: 'See the installed agent surface across a five-machine macOS/Linux mix, then act on exact drift.', href: '/what-it-does/keep-machines-current/', icon: 'signal' },
  { number: '03', title: 'Distribute a skill', text: 'Write one skill, declare it once, and move it through item-level review and canary evidence.', href: '/what-it-does/distribute-a-skill/', icon: 'box' },
  { number: '04', title: 'Place work with intent', text: 'Route a request to the harness, model, effort, and ready machine that fit it.', href: '/what-it-does/run-work-on-another-machine/', icon: 'route' },
];
---
<section class="promises wrap" aria-labelledby="promises-title">
  <div class="section-heading"><p class="eyebrow">A clear path through the yard</p><h2 id="promises-title">Four promises.<br /><span>One accountable system.</span></h2></div>
  <div class="promise-grid">
    {promises.map((promise) => <a class="promise-card" href={withBase(promise.href)}>
      <span class="card-number">{promise.number}</span><span class={`promise-icon icon-${promise.icon}`} aria-hidden="true"></span>
      <h3>{promise.title}</h3><p>{promise.text}</p><span class="card-arrow" aria-hidden="true">↗</span>
    </a>)}
  </div>
</section>
