---
import { withBase } from '../config/site.mjs';
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="signal-dot"></span> A better operating model for agent work</p>
    <h1 id="hero-title">Merge agent output<br /><em>with proof it arrived.</em></h1>
    <p class="hero-lead">Railyard is a free, open-source plugin for Claude Code and Codex. Install it from a marketplace to run delivery. Per-dispatch model economics, review settlement, and merge proof all travel with the change, from request to arrival.</p>
    <div class="hero-actions"><a class="button button-primary" href={withBase('/start/')}>Run a first delivery <span aria-hidden="true">→</span></a><a class="text-link" href={withBase('/what-it-does/')}>Explore ten practices <span aria-hidden="true">→</span></a></div>
  </div>
  <div class="hero-art" aria-label="A rail diagram showing intent moving through review to proof" role="img">
    <img src={withBase('/assets/hero-rail.svg')} alt="" width="720" height="520" />
    <div class="art-caption"><span>intent</span><span>review</span><span>proof</span></div>
  </div>
</section>
