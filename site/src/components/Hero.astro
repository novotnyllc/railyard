---
import { withBase } from '../config/site.mjs';
---
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="signal-dot"></span> The delivery system for agent work</p>
    <h1 id="hero-title">Say “go do X.”<br /><em>Get back a verified result.</em></h1>
    <p class="hero-lead">Railyard turns plain-language intent into a reviewed, delivered change with an observable receipt. The work moves; the evidence arrives with it.</p>
    <div class="hero-actions"><a class="button button-primary" href={withBase('/start/')}>Start here <span aria-hidden="true">→</span></a><a class="text-link" href={withBase('/what-it-does/')}>Explore ten outcomes <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="hero-art" aria-label="A rail diagram showing intent moving through review to proof" role="img">
    <img src={withBase('/assets/hero-rail.svg')} alt="" width="720" height="520" />
    <div class="art-caption"><span>intent</span><span>review</span><span>proof</span></div>
  </div>
</section>
